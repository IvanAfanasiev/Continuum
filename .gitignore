# Generated by Cargo
# will have compiled files and executables
/debug/
/target/
backend/target/

# Flutter/Dart generated files
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies
/.packages
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/jniLibs/
frontend/android/app/src/main/rustLibs/
frontend/windows/flutter/ephemeral/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt
