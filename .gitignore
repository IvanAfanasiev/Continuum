# Continuum — files that must never be pushed.

# Flutter/Dart tooling and caches (regenerated by `flutter pub get`)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/
flutter_*.log
build/
build_tool_runner.dill

# Rust build outputs and local artifacts
rust/target/
rust/build/
**/*.rs.bk
Cargo.lock.bak

# Android
android/.gradle/
android/local.properties
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/
android/app/src/main/jniLibs/
android/.kotlin/

# iOS / macOS
ios/.symlinks/
ios/Flutter/.last_build_id
ios/Flutter/flutter_export_environment.sh
ios/build/
macos/build/

# Linux / Windows
linux/build/
linux/flutter/ephemeral/
windows/build/
windows/flutter/ephemeral/

# IDE and editors
.idea/
.vscode/
*.iml
*.swp
*~

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Logs, temporary files and local secrets
*.log
*.bak
*.tmp
*.jks
*.keystore
*.p12
*.p8
*.key
.env
.env.*
!.env.example
